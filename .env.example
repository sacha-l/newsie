DIGEST_TZ=Europe/Berlin
INGEST_LOOKBACK_HOURS=18
MAX_STORIES_PER_DIGEST=8
MAX_SOURCES_PER_RUN=40
MAX_ARTICLES_PER_SOURCE=25
MAX_PIPELINE_STEPS=64
MAX_LLM_TOKENS_PER_RUN=80000
MAX_FETCHES_PER_RUN=200
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
CLUSTER_SIMILARITY_THRESHOLD=0.82
PLAYWRIGHT_ENABLED=false
KILL_SWITCH=false
DEMO_MODE=true
# Local Phase 2 default:
DATABASE_URL=sqlite:///./newsie_data.db
